{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Daviswhistle/Tada/contracts/worker/v1",
  "$comment": "Offline identifier. Narrow read-only worker admission protocol; policy and grants are trusted-host outputs, never authentic merely because schema-valid. Existing task/control v1 is unchanged.",
  "$defs": {
    "WorkerId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "WorkerText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "WorkerHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "WorkerCounter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "WorkerPositive": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "WorkerDecision": {
      "type": "string",
      "enum": [
        "DENY",
        "ALLOW",
        "REQUIRE_DECISION",
        "HANDOFF"
      ]
    },
    "WorkerOrigin": {
      "type": "string",
      "enum": [
        "user_request",
        "user_decision",
        "local_policy"
      ]
    },
    "WorkerRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "$ref": "#/$defs/WorkerId"
        },
        "tool_version": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "resource": {
          "$ref": "#/$defs/WorkerText"
        },
        "purpose": {
          "$ref": "#/$defs/WorkerText"
        },
        "decision": {
          "$ref": "#/$defs/WorkerDecision"
        }
      },
      "required": [
        "tool",
        "tool_version",
        "resource",
        "purpose",
        "decision"
      ]
    },
    "WorkerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "profile_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "revision": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "origin": {
          "$ref": "#/$defs/WorkerOrigin"
        },
        "denied_tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerId"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WorkerRule"
          },
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "grant_ttl_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "revision",
        "origin",
        "denied_tools",
        "rules",
        "max_calls",
        "grant_ttl_ms"
      ]
    },
    "WorkerArguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected_hash": {
          "$ref": "#/$defs/WorkerHash"
        }
      },
      "required": [
        "expected_hash"
      ]
    },
    "WorkerProposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "call_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "task_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "tool": {
          "$ref": "#/$defs/WorkerId"
        },
        "tool_version": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "resource": {
          "$ref": "#/$defs/WorkerText"
        },
        "purpose": {
          "$ref": "#/$defs/WorkerText"
        },
        "arguments": {
          "$ref": "#/$defs/WorkerArguments"
        }
      },
      "required": [
        "schema_version",
        "call_id",
        "task_id",
        "tool",
        "tool_version",
        "resource",
        "purpose",
        "arguments"
      ]
    },
    "WorkerGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "grant_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "subject": {
          "$ref": "#/$defs/WorkerId"
        },
        "task_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "tool": {
          "$ref": "#/$defs/WorkerId"
        },
        "tool_version": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "resource": {
          "$ref": "#/$defs/WorkerText"
        },
        "purpose": {
          "$ref": "#/$defs/WorkerText"
        },
        "payload_hash": {
          "$ref": "#/$defs/WorkerHash"
        },
        "profile_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "policy_revision": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "generation": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "cancel_epoch": {
          "$ref": "#/$defs/WorkerCounter"
        },
        "fencing_token": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "expires_at_ms": {
          "$ref": "#/$defs/WorkerPositive"
        }
      },
      "required": [
        "schema_version",
        "grant_id",
        "subject",
        "task_id",
        "tool",
        "tool_version",
        "resource",
        "purpose",
        "payload_hash",
        "profile_id",
        "policy_revision",
        "generation",
        "cancel_epoch",
        "fencing_token",
        "expires_at_ms"
      ]
    },
    "WorkerAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "decision": {
          "$ref": "#/$defs/WorkerDecision"
        },
        "reason": {
          "$ref": "#/$defs/WorkerId"
        },
        "grant": {
          "$ref": "#/$defs/WorkerGrant"
        }
      },
      "required": [
        "schema_version",
        "decision",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ALLOW"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "grant"
            ]
          },
          "else": {
            "not": {
              "required": [
                "grant"
              ]
            }
          }
        }
      ]
    },
    "WorkerCall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grant_ref": {
          "$ref": "#/$defs/WorkerId"
        },
        "proposal": {
          "$ref": "#/$defs/WorkerProposal"
        },
        "policy_revision": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "generation": {
          "$ref": "#/$defs/WorkerPositive"
        },
        "cancel_epoch": {
          "$ref": "#/$defs/WorkerCounter"
        },
        "fencing_token": {
          "$ref": "#/$defs/WorkerPositive"
        }
      },
      "required": [
        "grant_ref",
        "proposal",
        "policy_revision",
        "generation",
        "cancel_epoch",
        "fencing_token"
      ]
    },
    "WorkerRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/WorkerId"
        },
        "method": {
          "type": "string",
          "const": "tool.invoke"
        },
        "params": {
          "$ref": "#/$defs/WorkerCall"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method",
        "params"
      ]
    },
    "WorkerResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "call_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "grant_ref": {
          "$ref": "#/$defs/WorkerId"
        },
        "status": {
          "type": "string",
          "const": "ok"
        },
        "side_effect_state": {
          "type": "string",
          "const": "none"
        },
        "contract_hash": {
          "$ref": "#/$defs/WorkerHash"
        },
        "evidence_ref": {
          "$ref": "#/$defs/WorkerId"
        },
        "replayed": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "call_id",
        "grant_ref",
        "status",
        "side_effect_state",
        "contract_hash",
        "evidence_ref",
        "replayed"
      ]
    },
    "WorkerReply": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "$ref": "#/$defs/WorkerId"
        },
        "result": {
          "$ref": "#/$defs/WorkerResult"
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    }
  }
}
