{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tada.invalid/contracts/model.v1.json",
  "$defs": {
    "ModelId": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9_.:-]+$"},
    "ModelCounter": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "ModelTextDelta": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"text_delta"},"value":{"type":"string","maxLength":4096}},"required":["schema_version","request_id","seq","type","value"],"additionalProperties":false},
    "ModelToolCallDelta": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"tool_call_delta"},"call_id":{"$ref":"#/$defs/ModelId"},"chunk":{"type":"string","maxLength":4096}},"required":["schema_version","request_id","seq","type","call_id","chunk"],"additionalProperties":false},
    "ModelToolCallComplete": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"tool_call_complete"},"call_id":{"$ref":"#/$defs/ModelId"},"payload_json":{"type":"string","minLength":1,"maxLength":16384}},"required":["schema_version","request_id","seq","type","call_id","payload_json"],"additionalProperties":false},
    "ModelReasoningHandle": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"reasoning_handle"},"encrypted_ref":{"type":"string","minLength":1,"maxLength":256,"pattern":"^encrypted:[A-Za-z0-9_.:-]+$"}},"required":["schema_version","request_id","seq","type","encrypted_ref"],"additionalProperties":false},
    "ModelUsage": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"usage"},"input_tokens":{"$ref":"#/$defs/ModelCounter"},"output_tokens":{"$ref":"#/$defs/ModelCounter"}},"required":["schema_version","request_id","seq","type","input_tokens","output_tokens"],"additionalProperties":false},
    "ModelRateLimit": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"rate_limit"},"retry_after_ms":{"type":"integer","minimum":1,"maximum":86400000}},"required":["schema_version","request_id","seq","type","retry_after_ms"],"additionalProperties":false},
    "ModelCompleted": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"completed"},"finish_reason":{"type":"string","enum":["stop","tool_calls"]}},"required":["schema_version","request_id","seq","type","finish_reason"],"additionalProperties":false},
    "ModelFailed": {"type":"object","properties":{"schema_version":{"type":"integer","const":1},"request_id":{"$ref":"#/$defs/ModelId"},"seq":{"type":"integer","minimum":1,"maximum":4096},"type":{"type":"string","const":"failed"},"category":{"type":"string","enum":["network","auth","capacity","protocol","unsupported"]}},"required":["schema_version","request_id","seq","type","category"],"additionalProperties":false},
    "ModelEvent": {"oneOf":[{"$ref":"#/$defs/ModelTextDelta"},{"$ref":"#/$defs/ModelToolCallDelta"},{"$ref":"#/$defs/ModelToolCallComplete"},{"$ref":"#/$defs/ModelReasoningHandle"},{"$ref":"#/$defs/ModelUsage"},{"$ref":"#/$defs/ModelRateLimit"},{"$ref":"#/$defs/ModelCompleted"},{"$ref":"#/$defs/ModelFailed"}]}
  }
}
